# ============================================================
# demo 项目 .gitignore
# 判断标准：换一台电脑能重新生成的东西 → 忽略
#           是项目源码 / 素材本身 → 提交
# ============================================================

# ---- Python 虚拟环境：必须忽略 ----
# .venv 里装的是这台机器上的依赖，和 Python 版本、路径绑定。
# 换电脑后按环境重建即可（你移植这个项目时做的就是这件事），
# 提交它只会往仓库里塞进几千个无用文件。
.venv/
venv/
env/
ENV/

# ---- Python 字节码缓存：必须忽略 ----
# 每次运行 python 都可能重新生成，且和 Python 版本绑定（你有 -35 和 -38 两套）
__pycache__/
*.py[cod]
*$py.class

# ---- 本地数据库：建议忽略，但这条由你决定 ----
# 现在 db.sqlite3 是空的。若课堂要求连同数据库一起交，把下面两行注释掉即可。
db.sqlite3
db.sqlite3-journal

# ---- 部署时才生成的静态文件汇总目录 ----
# 以后设置了 STATIC_ROOT，collectstatic 会把文件拷到这里，属于生成物。
# 注意：first/static/ 和 public_static/ 是你的素材，绝对不能忽略。
/staticfiles/
/static_root/

# ---- 大文件（可选，由你决定）----
# first/static/c919.mp4 有 19MB，会一起进仓库、一起拷 U 盘，仓库会明显变大。
# 想让它只留在本地就取消下面一行的注释，但另一台电脑上就没有这个视频了，
# playvideo.html 的视频会打不开。
# *.mp4

# ---- 日志与环境变量 ----
*.log
.env

# ---- 编辑器 / IDE ----
.idea/
.vscode/
*.swp

# ---- Windows / macOS 系统垃圾 ----
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/
